{
  "name": "dsh-desktop",
  "version": "1.5.6-preview.1",
  "private": true,
  "description": "Windows Electron host for an independently updatable DeepSeek Harness runtime",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown && tsdown --config tsdown.preload.config.ts",
    "dev": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder --win nsis --x64 --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "semver": "7.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.2"
  }
}
